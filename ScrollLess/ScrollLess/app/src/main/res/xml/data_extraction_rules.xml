<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 (API 31) and higher.
   Usage history and settings never go to cloud backup. A direct device-to-device transfer
   (e.g. moving to a new phone) may copy them, because the data stays with the user.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="scrollless.db" />
        <exclude domain="database" path="scrollless.db-wal" />
        <exclude domain="database" path="scrollless.db-shm" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
</data-extraction-rules>
